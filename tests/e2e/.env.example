# Copy this file to `.env` (gitignored) and fill in real values.
# Loaded by playwright.config.ts via dotenv.

# Admin password used by tests that need to onboard or log in.
# Must be >= 8 characters.
E2E_ADMIN_PASSWORD=correct-horse-battery-staple

# Port the test PHP server listens on. Change if 8123 is taken.
E2E_PORT=8123

# Optional: real provider credentials for tests that exercise discovery
# and live status fetching. Leave blank to skip those tests.
E2E_BESZEL_URL=
E2E_BESZEL_EMAIL=
E2E_BESZEL_PASSWORD=
E2E_UPTIMEROBOT_API_KEY=
