.DS_Store
Thumbs.db

# Composer (not used, but guard against accidental installs)
vendor/

# Node (only used for vendor script; node_modules never committed)
node_modules/

# Runtime files never committed
config/settings.json
cache/state.json
cache/state.json.lock
cache/backoff.json
cache/sessions/
cache/throttle/

# IDE
.idea/
.vscode/
*.code-workspace

# E2E tests (Playwright)
test-results/
playwright-report/
tests/e2e/.env
tests/e2e/.tmp/
