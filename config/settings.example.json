      "items": []
    },
    {
      "id":              "REPLACE_WITH_UUID_2",
      "provider":        "beszel",
      "providerVersion": 1,
      "name":            "Beszel",
      "config": {
        "url":      "https://YOUR_BESZEL_URL",
        "username": "YOUR_EMAIL",
        "password": "YOUR_PASSWORD"
